.PHONY: build test lint typecheck verify run dev clean

build:
	npm run build

test:
	npm test

lint:
	npm run lint

# verify: every gate — typecheck, lint, test, build, architecture. What CI should invoke.
# One definition means a green local run means something.
verify: typecheck lint test build
	@if command -v verikt >/dev/null 2>&1 && [ -f verikt.yaml ]; then \
		verikt check; \
	else \
		echo "verikt not installed or no verikt.yaml — skipping architecture check"; \
	fi

run:
	npm start

dev:
	npm run dev

clean:
	npm run clean

typecheck:
	npm run typecheck
