FROM golang:{{.GoVersion}}-bookworm

ARG GOLANGCI_LINT_VERSION=v1.64.8
ARG AIR_VERSION=v1.51.0

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    make \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install golangci-lint at a pinned version. go install verifies it against the
# Go checksum database; no remote install script is run.
RUN GOBIN=/usr/local/bin go install github.com/golangci/golangci-lint/cmd/golangci-lint@${GOLANGCI_LINT_VERSION}

# Install air (live reload)
RUN go install github.com/air-verse/air@${AIR_VERSION}

# Create non-root user
RUN groupadd --gid 1000 vscode \
    && useradd --uid 1000 --gid 1000 -m vscode

USER vscode
WORKDIR /workspace
