package middleware

import (
	"errors"
	"net/http"

	"{{ .ModulePath }}/platform/tenant"
)

// Tenant resolves the request's tenant through resolver and injects it into
// the request context. It fails closed: a request whose tenant cannot be
// resolved never reaches next. Mount it after the authentication middleware,
// so the resolver can read verified identity from the context.
//
// Start with tenant.NotConfigured and replace it with a resolver that reads
// your verified auth claims; until then every request is refused with 500.
func Tenant(resolver tenant.TenantResolver) func(http.Handler) http.Handler {
	if resolver == nil {
		panic("middleware.Tenant: resolver is required")
	}
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			id, err := resolver.Resolve(r.Context(), r)
			switch {
			case errors.Is(err, tenant.ErrResolverNotConfigured):
				http.Error(w, "tenant resolution is not configured", http.StatusInternalServerError)
				return
			case err != nil || id == "":
				http.Error(w, http.StatusText(http.StatusForbidden), http.StatusForbidden)
				return
			}

			ctx := tenant.WithTenant(r.Context(), id)
			next.ServeHTTP(w, r.WithContext(ctx))
		})
	}
}
