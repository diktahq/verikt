package config

import (
	"bytes"
	"errors"
	"fmt"
	"io"
	"os"
	"strconv"
	"strings"

	"gopkg.in/yaml.v3"
)

// Config holds all configuration for the application.
type Config struct {
	App    AppConfig    `yaml:"app"`
	Logger LoggerConfig `yaml:"logger"`
	{{- if .HasHTTP}}
	HTTP   HTTPConfig   `yaml:"http"`
	{{- end}}
	{{- if .HasGRPC}}
	GRPC   GRPCConfig   `yaml:"grpc"`
	{{- end}}
	{{- if .HasKafka}}
	Kafka  KafkaConfig  `yaml:"kafka"`
	{{- end}}
	{{- if .HasMySQL}}
	MySQL  MySQLConfig  `yaml:"mysql"`
	{{- end}}
	{{- if .HasPostgreSQL}}
	Postgres PostgresConfig `yaml:"postgres"`
	{{- end}}
	{{- if .HasRedis}}
	Redis  RedisConfig  `yaml:"redis"`
	{{- end}}
	{{- if .HasMailpit}}
	Mailpit MailpitConfig `yaml:"mailpit"`
	{{- end}}
}


// AppConfig holds general application configuration.
type AppConfig struct {
	Name        string `yaml:"name"`
	Version     string `yaml:"version"`
	Environment string `yaml:"environment"`
	{{- if .HasI18n}}
	DefaultLocale string `yaml:"default_locale"`
	{{- end}}
}

// LoggerConfig holds logging configuration.
type LoggerConfig struct {
	Level  string `yaml:"level"`
	Format string `yaml:"format"`
}

{{- if .HasHTTP}}

// HTTPConfig holds HTTP server configuration.
type HTTPConfig struct {
	Port         int `yaml:"port"`
	ReadTimeout  int `yaml:"read_timeout"`
	WriteTimeout int `yaml:"write_timeout"`
}
{{- end}}

{{- if .HasGRPC}}

// GRPCConfig holds gRPC server configuration.
type GRPCConfig struct {
	Port       int  `yaml:"port"`
	Reflection bool `yaml:"reflection"`
}
{{- end}}

{{- if .HasKafka}}

// KafkaConfig holds Kafka consumer configuration.
type KafkaConfig struct {
	Brokers       []string `yaml:"brokers"`
	ConsumerGroup string   `yaml:"consumer_group"`
	Topics        []string `yaml:"topics"`
}
{{- end}}

{{- if .HasMySQL}}

// MySQLConfig holds MySQL connection configuration.
type MySQLConfig struct {
	// A DSN carries the password, so it has no yaml key: `yaml:"-"` plus the
	// decoder's KnownFields makes `dsn:` in the config file an unknown field and
	// the whole file is refused. Documenting that a secret does not belong in a
	// committed file is advice; this makes it a rule. Set MYSQL_DSN instead.
	DSN             string `yaml:"-"`
	MaxOpenConns    int    `yaml:"max_open_conns"`
	MaxIdleConns    int    `yaml:"max_idle_conns"`
	ConnMaxLifetime int    `yaml:"conn_max_lifetime"`
}
{{- end}}

{{- if .HasPostgreSQL}}

// PostgresConfig holds PostgreSQL connection configuration.
type PostgresConfig struct {
	// Carries the password — see MySQLConfig.DSN. Set POSTGRES_URL instead.
	URL      string `yaml:"-"`
	MaxConns int32  `yaml:"max_conns"`
	MinConns int32  `yaml:"min_conns"`
}
{{- end}}

{{- if .HasRedis}}

// RedisConfig holds Redis connection configuration.
type RedisConfig struct {
	Addr     string `yaml:"addr"`
	// A credential — see MySQLConfig.DSN. Set REDIS_PASSWORD instead.
	Password string `yaml:"-"`
	DB       int    `yaml:"db"`
}
{{- end}}
{{- if .HasMailpit}}

// MailpitConfig holds Mailpit SMTP configuration for local email testing.
type MailpitConfig struct {
	Host string `yaml:"host"`
	Port int    `yaml:"port"`
	From string `yaml:"from"`
}
{{- end}}

// Default returns the configuration a fresh checkout runs with.
//
// Defaults live here rather than in struct tags because they have to be applied
// *before* the file is read. A tag that supplies a default during parsing runs on
// every parse, so it overwrites the value the file set — which silently ignores
// the config file for every field that has a default.
func Default() Config {
	return Config{
		App: AppConfig{
			Name:        "{{.ServiceName}}",
			Environment: "development",
			{{- if .HasI18n}}
			DefaultLocale: "en",
			{{- end}}
		},
		Logger: LoggerConfig{
			Level:  "info",
			Format: "json",
		},
		{{- if .HasHTTP}}
		HTTP: HTTPConfig{
			Port:         8080,
			ReadTimeout:  30,
			WriteTimeout: 30,
		},
		{{- end}}
		{{- if .HasGRPC}}
		GRPC: GRPCConfig{
			Port: 9090,
			// Reflection exposes the service schema: development only (INV-003).
			Reflection: false,
		},
		{{- end}}
		{{- if .HasKafka}}
		Kafka: KafkaConfig{
			Brokers:       []string{"localhost:9092"},
			ConsumerGroup: "{{.ServiceName}}-group",
		},
		{{- end}}
		{{- if .HasMySQL}}
		MySQL: MySQLConfig{
			MaxOpenConns: 25,
			MaxIdleConns: 5,
		},
		{{- end}}
		{{- if .HasPostgreSQL}}
		Postgres: PostgresConfig{
			MaxConns: 25,
			MinConns: 5,
		},
		{{- end}}
		{{- if .HasRedis}}
		Redis: RedisConfig{
			Addr: "localhost:6379",
		},
		{{- end}}
		{{- if .HasMailpit}}
		Mailpit: MailpitConfig{
			Host: "localhost",
			Port: 1025,
			From: "noreply@{{.ServiceName}}.local",
		},
		{{- end}}
	}
}

// Load builds the configuration from three sources, each overriding the last:
// defaults in code, then the YAML file, then the environment.
//
// The order matters and is deliberate. Defaults are established before the file
// is read, so a value the file sets is never overwritten by a default it did not
// ask for. The environment is applied last, because that is where deployment
// differences and every credential come from.
//
// configPath may be empty, in which case defaults and the environment are the
// only sources — which is how this runs in a container with no config file
// mounted.
func Load(configPath string) (*Config, error) {
	cfg := Default()

	if configPath != "" {
		if err := loadFile(configPath, &cfg); err != nil {
			return nil, err
		}
	}

	if err := applyEnv(&cfg); err != nil {
		return nil, err
	}

	return &cfg, nil
}

// loadFile reads configPath over cfg, rejecting keys the Config does not define.
//
// KnownFields is what makes the `yaml:"-"` tags on credentials load-bearing: a
// secret written into the committed config file is an unknown key, so the file
// is refused with the offending line rather than quietly accepted.
func loadFile(configPath string, cfg *Config) error {
	data, err := os.ReadFile(configPath)
	if err != nil {
		return fmt.Errorf("read config file: %w", err)
	}

	decoder := yaml.NewDecoder(bytes.NewReader(data))
	decoder.KnownFields(true)
	if err := decoder.Decode(cfg); err != nil && !errors.Is(err, io.EOF) {
		return fmt.Errorf("parse %s: %w", configPath, err)
	}

	return nil
}

// applyEnv overrides configuration from the environment.
//
// Only variables that are actually set are applied, so an unset variable leaves
// the file's value alone. That is why each field is read explicitly rather than
// through default-carrying struct tags: a tag that supplies a default on every
// parse overwrites whatever the file legitimately set, which silently ignores the
// config file for any field that has one.
//
// A malformed value is an error, not a shrug. Ignoring one meant
// `HTTP_PORT=eighty-eighty` left the service on whatever port the file happened
// to name, with nothing said — an operator typo that silently fails to take
// effect is the same class of failure as a check that silently passes. All bad
// values are reported together, so one run tells you about every typo.
func applyEnv(cfg *Config) error {
	var errs []error
	fail := func(err error) {
		if err != nil {
			errs = append(errs, err)
		}
	}

	setString(&cfg.App.Name, "APP_NAME")
	setString(&cfg.App.Version, "APP_VERSION")
	setString(&cfg.App.Environment, "APP_ENVIRONMENT")
	{{- if .HasI18n}}
	setString(&cfg.App.DefaultLocale, "APP_DEFAULT_LOCALE")
	{{- end}}
	setString(&cfg.Logger.Level, "LOG_LEVEL")
	setString(&cfg.Logger.Format, "LOG_FORMAT")
	{{- if .HasHTTP}}
	fail(setInt(&cfg.HTTP.Port, "HTTP_PORT"))
	fail(setInt(&cfg.HTTP.ReadTimeout, "HTTP_READ_TIMEOUT"))
	fail(setInt(&cfg.HTTP.WriteTimeout, "HTTP_WRITE_TIMEOUT"))
	{{- end}}
	{{- if .HasGRPC}}
	fail(setInt(&cfg.GRPC.Port, "GRPC_PORT"))
	// Reflection exposes the service schema, so enabling it is deliberate (INV-003).
	fail(setBool(&cfg.GRPC.Reflection, "GRPC_REFLECTION"))
	{{- end}}
	{{- if .HasKafka}}
	setStrings(&cfg.Kafka.Brokers, "KAFKA_BROKERS")
	setString(&cfg.Kafka.ConsumerGroup, "KAFKA_CONSUMER_GROUP")
	setStrings(&cfg.Kafka.Topics, "KAFKA_TOPICS")
	{{- end}}
	{{- if .HasMySQL}}
	// Credential: has no yaml key, so this is the only way to supply it.
	setString(&cfg.MySQL.DSN, "MYSQL_DSN")
	fail(setInt(&cfg.MySQL.MaxOpenConns, "MYSQL_MAX_OPEN_CONNS"))
	fail(setInt(&cfg.MySQL.MaxIdleConns, "MYSQL_MAX_IDLE_CONNS"))
	fail(setInt(&cfg.MySQL.ConnMaxLifetime, "MYSQL_CONN_MAX_LIFETIME"))
	{{- end}}
	{{- if .HasPostgreSQL}}
	// Credential: has no yaml key, so this is the only way to supply it.
	setString(&cfg.Postgres.URL, "POSTGRES_URL")
	fail(setInt32(&cfg.Postgres.MaxConns, "POSTGRES_MAX_CONNS"))
	fail(setInt32(&cfg.Postgres.MinConns, "POSTGRES_MIN_CONNS"))
	{{- end}}
	{{- if .HasRedis}}
	setString(&cfg.Redis.Addr, "REDIS_ADDR")
	// Credential: has no yaml key, so this is the only way to supply it.
	setString(&cfg.Redis.Password, "REDIS_PASSWORD")
	fail(setInt(&cfg.Redis.DB, "REDIS_DB"))
	{{- end}}
	{{- if .HasMailpit}}
	setString(&cfg.Mailpit.Host, "MAILPIT_HOST")
	fail(setInt(&cfg.Mailpit.Port, "MAILPIT_PORT"))
	setString(&cfg.Mailpit.From, "MAILPIT_FROM")
	{{- end}}

	return errors.Join(errs...)
}

// setString assigns the environment variable to target when it is set.
// An unset variable leaves target untouched; an empty one is a real value.
func setString(target *string, key string) {
	if v, ok := os.LookupEnv(key); ok {
		*target = v
	}
}

// setInt assigns the environment variable to target when it is set, and reports
// a value that is not an integer.
func setInt(target *int, key string) error {
	v, ok := os.LookupEnv(key)
	if !ok {
		return nil
	}
	parsed, err := strconv.Atoi(v)
	if err != nil {
		return fmt.Errorf("%s=%q is not an integer", key, v)
	}
	*target = parsed
	return nil
}

// setInt32 is setInt for the int32 fields pgx uses for pool sizes.
func setInt32(target *int32, key string) error {
	v, ok := os.LookupEnv(key)
	if !ok {
		return nil
	}
	parsed, err := strconv.ParseInt(v, 10, 32)
	if err != nil {
		return fmt.Errorf("%s=%q is not a 32-bit integer", key, v)
	}
	*target = int32(parsed)
	return nil
}

// setBool assigns the environment variable to target when it is set, and reports
// a value that is not a boolean. Accepts what strconv.ParseBool accepts:
// 1, t, T, TRUE, true, True and their false counterparts.
func setBool(target *bool, key string) error {
	v, ok := os.LookupEnv(key)
	if !ok {
		return nil
	}
	parsed, err := strconv.ParseBool(v)
	if err != nil {
		return fmt.Errorf("%s=%q is not a boolean (use true or false)", key, v)
	}
	*target = parsed
	return nil
}

// setStrings assigns a comma-separated environment variable to target.
func setStrings(target *[]string, key string) {
	v, ok := os.LookupEnv(key)
	if !ok {
		return
	}
	parts := strings.Split(v, ",")
	out := make([]string, 0, len(parts))
	for _, p := range parts {
		if trimmed := strings.TrimSpace(p); trimmed != "" {
			out = append(out, trimmed)
		}
	}
	*target = out
}
