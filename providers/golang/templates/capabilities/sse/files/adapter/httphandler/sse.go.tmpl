package {{index .ArchPaths "HTTPHandlerPkg"}}

import (
	"errors"
	"fmt"
	"net/http"
	"time"
)

const (
	// DefaultSSEKeepAlive is how often an idle stream sends a comment. It is
	// shorter than the 30-60 seconds most proxies wait before dropping a quiet
	// connection.
	DefaultSSEKeepAlive = 15 * time.Second

	// sseWriteTimeout bounds each write to a stream. The server's WriteTimeout
	// is measured from the start of the request, so a stream replaces it with a
	// deadline that moves forward on every write: a client that stops reading is
	// still disconnected, a client that keeps reading is not.
	sseWriteTimeout = 10 * time.Second
)

// EventWriter wraps an http.ResponseWriter to send Server-Sent Events.
type EventWriter struct {
	w  http.ResponseWriter
	rc *http.ResponseController
}

// NewEventWriter starts an event stream on w. It returns an error if the
// writer cannot flush.
func NewEventWriter(w http.ResponseWriter) (*EventWriter, error) {
	ew := &EventWriter{w: w, rc: http.NewResponseController(w)}

	w.Header().Set("Content-Type", "text/event-stream")
	w.Header().Set("Cache-Control", "no-cache")
	w.Header().Set("Connection", "keep-alive")
	w.WriteHeader(http.StatusOK)
	if err := ew.flush(); err != nil {
		return nil, err
	}
	return ew, nil
}

// Send writes a named SSE event with the given data and flushes immediately.
func (ew *EventWriter) Send(event, data string) error {
	return ew.write("event: %s\ndata: %s\n\n", event, data)
}

// KeepAlive writes an SSE comment, which clients ignore, to hold the
// connection open through idle proxies.
func (ew *EventWriter) KeepAlive() error {
	return ew.write(": keep-alive\n\n")
}

// write extends the connection's write deadline, then writes and flushes.
// ErrNotSupported means the writer has no deadline to extend (a test
// recorder, for one), so there is nothing to lift.
func (ew *EventWriter) write(format string, args ...any) error {
	if err := ew.rc.SetWriteDeadline(time.Now().Add(sseWriteTimeout)); err != nil && !errors.Is(err, http.ErrNotSupported) {
		return fmt.Errorf("extend write deadline: %w", err)
	}
	if _, err := fmt.Fprintf(ew.w, format, args...); err != nil {
		return fmt.Errorf("write sse event: %w", err)
	}
	return ew.flush()
}

func (ew *EventWriter) flush() error {
	if err := ew.rc.Flush(); err != nil {
		return fmt.Errorf("flush sse stream: %w", err)
	}
	return nil
}

// NewSSEHandler returns a handler that streams server-sent events, sending a
// keep-alive comment every keepAlive while idle. Register it outside the
// request-timeout group: the stream ends when the client goes away, not when a
// request budget runs out.
func NewSSEHandler(keepAlive time.Duration) http.HandlerFunc {
	if keepAlive <= 0 {
		keepAlive = DefaultSSEKeepAlive
	}
	return func(w http.ResponseWriter, r *http.Request) {
		ew, err := NewEventWriter(w)
		if err != nil {
			// The 200 and headers are already on the wire, so no error status
			// can follow. A writer that cannot flush cannot stream: end here.
			return
		}

		ticker := time.NewTicker(keepAlive)
		defer ticker.Stop()

		for {
			select {
			case <-r.Context().Done():
				return
			case <-ticker.C:
				if err := ew.KeepAlive(); err != nil {
					return
				}
			}
		}
	}
}
