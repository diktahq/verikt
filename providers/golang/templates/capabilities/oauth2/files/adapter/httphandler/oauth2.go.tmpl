// OAuth2Config holds OAuth2 provider configuration.
type OAuth2Config struct {
	ClientID      string
	ClientSecret  string
	TokenURL      string
	AuthURL       string
	IntrospectURL string // RFC 7662 token introspection endpoint
	RedirectURL   string
	Scopes        string
}

// TokenResponse represents an OAuth2 token response.
type TokenResponse struct {
	AccessToken  string `json:"access_token"`
	TokenType    string `json:"token_type"`
	ExpiresIn    int    `json:"expires_in"`
	RefreshToken string `json:"refresh_token,omitempty"`
}

// IntrospectionResponse represents an RFC 7662 introspection response.
type IntrospectionResponse struct {
	Active   bool   `json:"active"`
	Sub      string `json:"sub,omitempty"`
	ClientID string `json:"client_id,omitempty"`
	Scope    string `json:"scope,omitempty"`
}

// OAuth2Middleware validates Bearer tokens via introspection on incoming requests.
func OAuth2Middleware(cfg OAuth2Config) func(http.Handler) http.Handler {
	if cfg.IntrospectURL == "" {
		panic("OAuth2Middleware: IntrospectURL is required — tokens must be validated")
	}
	client := &http.Client{Timeout: 10 * time.Second}

	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			authHeader := r.Header.Get("Authorization")
			if authHeader == "" {
				http.Error(w, "missing authorization header", http.StatusUnauthorized)
				return
			}

			parts := strings.SplitN(authHeader, " ", 2)
			if len(parts) != 2 || !strings.EqualFold(parts[0], "bearer") {
				http.Error(w, "invalid authorization header", http.StatusUnauthorized)
				return
			}

			token := strings.TrimSpace(parts[1])
			if token == "" {
				http.Error(w, "empty bearer token", http.StatusUnauthorized)
				return
			}

			// Validate token via introspection (RFC 7662).
			active, err := introspectToken(r.Context(), client, cfg, token)
			if err != nil || !active {
				http.Error(w, "invalid or expired token", http.StatusUnauthorized)
				return
			}

			next.ServeHTTP(w, r)
		})
	}
}

// introspectToken calls the OAuth2 introspection endpoint to validate a token.
func introspectToken(ctx context.Context, client *http.Client, cfg OAuth2Config, token string) (bool, error) {
	data := url.Values{
		"token":           {token},
		"token_type_hint": {"access_token"},
	}.Encode()

	req, err := http.NewRequestWithContext(ctx, http.MethodPost, cfg.IntrospectURL, strings.NewReader(data))
	if err != nil {
		return false, fmt.Errorf("creating introspection request: %w", err)
	}
	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
	req.SetBasicAuth(cfg.ClientID, cfg.ClientSecret)

	resp, err := client.Do(req)
	if err != nil {
		return false, fmt.Errorf("introspection request failed: %w", err)
	}
	defer resp.Body.Close()

	if resp.StatusCode != http.StatusOK {
		return false, fmt.Errorf("introspection returned status %d", resp.StatusCode)
	}

	var result IntrospectionResponse
	if err := json.NewDecoder(resp.Body).Decode(&result); err != nil {
		return false, fmt.Errorf("decoding introspection response: %w", err)
	}

	return result.Active, nil
}

const (
	// oauth2StateCookie binds a pending authorization to the browser that
	// started it. The __Host- prefix makes the browser refuse the cookie unless
	// it is Secure, host-only and scoped to "/".
	oauth2StateCookie = "__Host-oauth2_state"
	oauth2StateTTL    = 10 * time.Minute

	// maxPendingOAuth2States caps unfinished logins held in memory. Login is
	// reachable without authentication, so without a cap anyone could grow
	// the store without bound.
	maxPendingOAuth2States = 10_000
)

// oauth2StateStore holds issued state values until they are used once or
// expire. Replace it with Redis or a database when running more than one
// instance, since the callback may reach a different instance than Login.
//
// When the store is full, issuing a new state evicts the oldest pending one.
// Refusing new logins instead would let an unauthenticated flood of
// /auth/login requests lock every user out for oauth2StateTTL. With eviction,
// a flood of more than maxPendingOAuth2States logins within oauth2StateTTL can
// still push out a login in progress: that user's callback fails with 400 and
// they start the login again. A flood cannot forge or reuse a state, and
// memory stays bounded. Put the rate-limiting capability in front of Login to
// make that flood expensive.
//
// Every state has the same TTL, so issue order is also expiry order: expired
// states are dropped from the front of the list and the oldest pending state
// is always at the front. No operation scans the whole store.
type oauth2StateStore struct {
	mu      sync.Mutex
	entries map[string]*list.Element // state -> element holding a pendingState
	order   *list.List               // pendingStates, oldest first
}

type pendingState struct {
	value  string
	expiry time.Time
}

func newOAuth2StateStore() *oauth2StateStore {
	return &oauth2StateStore{entries: make(map[string]*list.Element), order: list.New()}
}

// issue creates a random state value and records it.
func (s *oauth2StateStore) issue(now time.Time) (string, error) {
	b := make([]byte, 32)
	if _, err := rand.Read(b); err != nil {
		return "", fmt.Errorf("generating state: %w", err)
	}
	state := hex.EncodeToString(b)

	s.mu.Lock()
	defer s.mu.Unlock()
	for front := s.order.Front(); front != nil && !now.Before(front.Value.(pendingState).expiry); front = s.order.Front() {
		s.remove(front)
	}
	if s.order.Len() >= maxPendingOAuth2States {
		s.remove(s.order.Front())
	}
	s.entries[state] = s.order.PushBack(pendingState{value: state, expiry: now.Add(oauth2StateTTL)})
	return state, nil
}

// consume reports whether state was issued and has not expired, and removes
// it so it can never be used again.
func (s *oauth2StateStore) consume(state string, now time.Time) bool {
	s.mu.Lock()
	defer s.mu.Unlock()
	elem, ok := s.entries[state]
	if !ok {
		return false
	}
	s.remove(elem)
	return now.Before(elem.Value.(pendingState).expiry)
}

// remove drops one pending state. The caller holds s.mu.
func (s *oauth2StateStore) remove(elem *list.Element) {
	delete(s.entries, elem.Value.(pendingState).value)
	s.order.Remove(elem)
}

// OAuth2Flow runs the authorization code flow: Login sends the browser to the
// provider, Callback completes it. Mount both on the router, e.g.:
//
//	flow := NewOAuth2Flow(cfg)
//	r.Get("/auth/login", flow.Login)
//	r.Get("/auth/callback", flow.Callback) // must match cfg.RedirectURL
//
// Login binds a single-use state value to the browser with an HttpOnly,
// Secure, SameSite=Lax cookie, and Callback accepts the provider's redirect
// only when the returned state matches that cookie. This stops login CSRF: an
// attacker cannot finish their own login in a victim's browser.
type OAuth2Flow struct {
	cfg    OAuth2Config
	states *oauth2StateStore
}

// NewOAuth2Flow creates the login and callback handlers for cfg.
func NewOAuth2Flow(cfg OAuth2Config) *OAuth2Flow {
	return &OAuth2Flow{cfg: cfg, states: newOAuth2StateStore()}
}

// Login starts the authorization code flow.
func (f *OAuth2Flow) Login(w http.ResponseWriter, r *http.Request) {
	authURL, err := url.Parse(f.cfg.AuthURL)
	if err != nil || authURL.Scheme == "" {
		http.Error(w, "oauth2 is not configured", http.StatusInternalServerError)
		return
	}
	state, err := f.states.issue(time.Now())
	if err != nil {
		http.Error(w, http.StatusText(http.StatusInternalServerError), http.StatusInternalServerError)
		return
	}

	http.SetCookie(w, &http.Cookie{
		Name:     oauth2StateCookie,
		Value:    state,
		Path:     "/",
		MaxAge:   int(oauth2StateTTL / time.Second),
		HttpOnly: true,
		Secure:   true,
		SameSite: http.SameSiteLaxMode,
	})

	q := authURL.Query()
	q.Set("response_type", "code")
	q.Set("client_id", f.cfg.ClientID)
	q.Set("redirect_uri", f.cfg.RedirectURL)
	q.Set("state", state)
	if f.cfg.Scopes != "" {
		q.Set("scope", f.cfg.Scopes)
	}
	authURL.RawQuery = q.Encode()
	http.Redirect(w, r, authURL.String(), http.StatusFound)
}

// Callback handles the provider's redirect back to cfg.RedirectURL.
//
// It writes the token response as JSON with Cache-Control: no-store. In a
// browser login you will usually create your own session here instead of
// handing the provider's tokens to the browser.
func (f *OAuth2Flow) Callback(w http.ResponseWriter, r *http.Request) {
	if !f.validCallbackState(w, r) {
		http.Error(w, "invalid or missing state parameter", http.StatusBadRequest)
		return
	}

	code := r.URL.Query().Get("code")
	if code == "" {
		http.Error(w, "missing authorization code", http.StatusBadRequest)
		return
	}

	tokenResp, err := ExchangeToken(r.Context(), f.cfg, code)
	if err != nil {
		http.Error(w, "token exchange failed", http.StatusBadGateway)
		return
	}

	w.Header().Set("Cache-Control", "no-store")
	w.Header().Set("Pragma", "no-cache")
	w.Header().Set("Content-Type", "application/json")
	if err := json.NewEncoder(w).Encode(tokenResp); err != nil {
		http.Error(w, "failed to encode response", http.StatusInternalServerError)
	}
}

// validCallbackState checks the returned state against the browser's state
// cookie in constant time, then consumes it server-side so it is single use.
// The cookie is cleared either way.
func (f *OAuth2Flow) validCallbackState(w http.ResponseWriter, r *http.Request) bool {
	http.SetCookie(w, &http.Cookie{
		Name:     oauth2StateCookie,
		Value:    "",
		Path:     "/",
		MaxAge:   -1,
		HttpOnly: true,
		Secure:   true,
		SameSite: http.SameSiteLaxMode,
	})

	state := r.URL.Query().Get("state")
	cookie, err := r.Cookie(oauth2StateCookie)
	if err != nil || state == "" {
		return false
	}
	if subtle.ConstantTimeCompare([]byte(cookie.Value), []byte(state)) != 1 {
		return false
	}
	return f.states.consume(state, time.Now())
}

// ExchangeToken exchanges an authorization code for an access token.
func ExchangeToken(ctx context.Context, cfg OAuth2Config, code string) (*TokenResponse, error) {
	data := url.Values{
		"grant_type":    {"authorization_code"},
		"code":          {code},
		"redirect_uri":  {cfg.RedirectURL},
		"client_id":     {cfg.ClientID},
		"client_secret": {cfg.ClientSecret},
	}.Encode()

	req, err := http.NewRequestWithContext(ctx, http.MethodPost, cfg.TokenURL, strings.NewReader(data))
	if err != nil {
		return nil, fmt.Errorf("creating token request: %w", err)
	}
	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")

	client := &http.Client{Timeout: 30 * time.Second}
	resp, err := client.Do(req)
	if err != nil {
		return nil, fmt.Errorf("executing token request: %w", err)
	}
	defer resp.Body.Close()

	if resp.StatusCode != http.StatusOK {
		return nil, fmt.Errorf("token endpoint returned status %d", resp.StatusCode)
	}

	var tokenResp TokenResponse
	if err := json.NewDecoder(resp.Body).Decode(&tokenResp); err != nil {
		return nil, fmt.Errorf("decoding token response: %w", err)
	}

	return &tokenResp, nil
}
