package {{index .ArchPaths "HTTPHandlerPkg"}}

import (
	"context"
	"log/slog"
	"net/http"
	"sync"
	"time"

	"github.com/gorilla/websocket"
)

const (
	// wsReadTimeout is how long a connection may stay silent. Clients that need
	// a longer quiet period should send pings.
	wsReadTimeout = 60 * time.Second

	// wsWriteTimeout bounds each write. Hijacking the connection clears the
	// server's deadlines, so without this a client that stops reading would
	// block a broadcast forever.
	wsWriteTimeout = 10 * time.Second
)

// upgrader leaves CheckOrigin unset, so gorilla accepts only same-origin
// browser requests (and clients that send no Origin header). Allowing other
// origins exposes every cookie-authenticated user to cross-site WebSocket
// hijacking: set CheckOrigin to an explicit allow-list when you need them.
var upgrader = websocket.Upgrader{
	ReadBufferSize:  1024,
	WriteBufferSize: 1024,
}

// WSConn wraps a WebSocket connection with metadata.
type WSConn struct {
	Conn *websocket.Conn
	ID   string

	// writeMu serialises writes: a gorilla connection supports one concurrent
	// writer, and broadcasts can overlap.
	writeMu sync.Mutex
}

// WriteMessage sends one message with a bounded write deadline.
func (c *WSConn) WriteMessage(messageType int, data []byte) error {
	c.writeMu.Lock()
	defer c.writeMu.Unlock()
	if err := c.Conn.SetWriteDeadline(time.Now().Add(wsWriteTimeout)); err != nil {
		return err
	}
	return c.Conn.WriteMessage(messageType, data)
}

// WSHub manages WebSocket connections.
type WSHub struct {
	mu     sync.RWMutex
	conns  map[string]*WSConn
	logger *slog.Logger
}

// NewWSHub creates a new WebSocket hub.
func NewWSHub(logger *slog.Logger) *WSHub {
	return &WSHub{
		conns:  make(map[string]*WSConn),
		logger: logger,
	}
}

// HandleWS upgrades HTTP to WebSocket and manages the connection. Register it
// outside the request-timeout group: the connection lives until the client
// leaves or stays silent past wsReadTimeout.
func (h *WSHub) HandleWS(w http.ResponseWriter, r *http.Request) {
	conn, err := upgrader.Upgrade(w, r, nil)
	if err != nil {
		h.logger.Error("websocket upgrade failed", "error", err)
		return
	}

	id := r.Header.Get("X-Request-ID")
	if id == "" {
		id = conn.RemoteAddr().String()
	}

	h.mu.Lock()
	h.conns[id] = &WSConn{Conn: conn, ID: id}
	h.mu.Unlock()

	h.logger.Info("websocket connected", "id", id)

	defer func() {
		h.mu.Lock()
		delete(h.conns, id)
		h.mu.Unlock()
		if err := conn.Close(); err != nil {
			h.logger.Debug("websocket close", "id", id, "error", err)
		}
		h.logger.Info("websocket disconnected", "id", id)
	}()

	h.readLoop(r.Context(), conn, id)
}

// readLoop reads until the client disconnects, goes silent past
// wsReadTimeout, or ctx ends.
func (h *WSHub) readLoop(ctx context.Context, conn *websocket.Conn, id string) {
	for ctx.Err() == nil {
		if err := conn.SetReadDeadline(time.Now().Add(wsReadTimeout)); err != nil {
			h.logger.Warn("websocket read deadline", "id", id, "error", err)
			return
		}
		if _, _, err := conn.ReadMessage(); err != nil {
			return
		}
	}
}

// Broadcast sends a message to all connected clients.
func (h *WSHub) Broadcast(_ context.Context, message []byte) {
	h.mu.RLock()
	defer h.mu.RUnlock()

	for id, ws := range h.conns {
		if err := ws.WriteMessage(websocket.TextMessage, message); err != nil {
			h.logger.Warn("broadcast failed", "id", id, "error", err)
		}
	}
}

// Count returns the number of active connections.
func (h *WSHub) Count() int {
	h.mu.RLock()
	defer h.mu.RUnlock()
	return len(h.conns)
}
