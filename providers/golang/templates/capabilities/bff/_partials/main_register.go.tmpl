// BFF gateway — backends come from BFF_SERVICES, endpoints from bffgateway.Routes().
	bffClients, err := bffgateway.ServicesFromEnv()
	if err != nil {
		return fmt.Errorf("bff gateway: %w", err)
	}
	bffgateway.NewHandler(bffgateway.NewGateway(bffClients), logger, bffgateway.Routes()...).RegisterRoutes(router)
