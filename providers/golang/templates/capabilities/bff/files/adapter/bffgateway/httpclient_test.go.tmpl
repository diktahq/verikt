func TestCallDecodesJSONResponse(t *testing.T) {
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		_, _ = w.Write([]byte(`{"name":"ada"}`))
	}))
	defer srv.Close()

	got, err := NewHTTPClient(srv.URL).Call(context.Background(), http.MethodGet, "/users/1", nil)
	if err != nil {
		t.Fatalf("Call: %v", err)
	}
	m, ok := got.(map[string]any)
	if !ok || m["name"] != "ada" {
		t.Fatalf("Call returned %#v, want map with name=ada", got)
	}
}

func TestCallRejectsResponseOverTheLimit(t *testing.T) {
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		_, _ = w.Write([]byte(`"` + strings.Repeat("x", 64) + `"`))
	}))
	defer srv.Close()

	_, err := NewHTTPClient(srv.URL, WithMaxResponseBytes(32)).Call(context.Background(), http.MethodGet, "/", nil)
	if !errors.Is(err, ErrResponseTooLarge) {
		t.Fatalf("Call err = %v, want ErrResponseTooLarge", err)
	}
}

func TestCallAcceptsResponseExactlyAtTheLimit(t *testing.T) {
	body := `"` + strings.Repeat("x", 30) + `"` // 32 bytes
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		_, _ = w.Write([]byte(body))
	}))
	defer srv.Close()

	if _, err := NewHTTPClient(srv.URL, WithMaxResponseBytes(int64(len(body)))).Call(context.Background(), http.MethodGet, "/", nil); err != nil {
		t.Fatalf("Call at the limit: %v", err)
	}
}

func TestCallReturnsTypedStatusError(t *testing.T) {
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		w.WriteHeader(http.StatusNotFound)
	}))
	defer srv.Close()

	_, err := NewHTTPClient(srv.URL).Call(context.Background(), http.MethodGet, "/users/9", nil)
	var statusErr *StatusError
	if !errors.As(err, &statusErr) {
		t.Fatalf("Call err = %v, want *StatusError", err)
	}
	if statusErr.StatusCode != http.StatusNotFound || statusErr.Path != "/users/9" {
		t.Fatalf("StatusError = %+v, want 404 for /users/9", statusErr)
	}
}

func TestCallTreatsEmptyBodyAsNil(t *testing.T) {
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		w.WriteHeader(http.StatusNoContent)
	}))
	defer srv.Close()

	got, err := NewHTTPClient(srv.URL).Call(context.Background(), http.MethodDelete, "/users/1", nil)
	if err != nil || got != nil {
		t.Fatalf("Call = %#v, %v; want nil, nil", got, err)
	}
}
// A backend redirect is not followed: the gateway would otherwise send its
// request, and the caller's data, to whatever host the backend names.
func TestCallDoesNotFollowRedirects(t *testing.T) {
	var followed atomic.Int32
	elsewhere := httptest.NewServer(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {
		followed.Add(1)
	}))
	defer elsewhere.Close()
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		http.Redirect(w, r, elsewhere.URL+"/steal", http.StatusFound)
	}))
	defer srv.Close()

	_, err := NewHTTPClient(srv.URL).Call(context.Background(), http.MethodGet, "/users/1", nil)
	if followed.Load() != 0 {
		t.Fatal("Call followed a backend redirect to another host")
	}
	var statusErr *StatusError
	if !errors.As(err, &statusErr) || statusErr.StatusCode != http.StatusFound {
		t.Fatalf("Call err = %v, want *StatusError with 302", err)
	}
}

// The path is appended to the configured base URL. Without exactly one leading
// slash it can change the host ("@evil.example/x") or become
// protocol-relative ("//evil.example/x").
func TestCallRejectsPathWithoutSingleLeadingSlash(t *testing.T) {
	var hits atomic.Int32
	srv := httptest.NewServer(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {
		hits.Add(1)
	}))
	defer srv.Close()

	for _, path := range []string{"", "users/1", "@evil.example/x", "//evil.example/x"} {
		if _, err := NewHTTPClient(srv.URL).Call(context.Background(), http.MethodGet, path, nil); !errors.Is(err, ErrInvalidPath) {
			t.Errorf("Call(%q) err = %v, want ErrInvalidPath", path, err)
		}
	}
	if hits.Load() != 0 {
		t.Fatalf("an invalid path reached the backend %d times", hits.Load())
	}
}
