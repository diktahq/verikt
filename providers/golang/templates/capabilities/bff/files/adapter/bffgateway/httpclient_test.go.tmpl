func TestCallDecodesJSONResponse(t *testing.T) {
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		_, _ = w.Write([]byte(`{"name":"ada"}`))
	}))
	defer srv.Close()

	got, err := NewHTTPClient(srv.URL).Call(context.Background(), http.MethodGet, "/users/1", nil)
	if err != nil {
		t.Fatalf("Call: %v", err)
	}
	m, ok := got.(map[string]any)
	if !ok || m["name"] != "ada" {
		t.Fatalf("Call returned %#v, want map with name=ada", got)
	}
}

func TestCallRejectsResponseOverTheLimit(t *testing.T) {
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		_, _ = w.Write([]byte(`"` + strings.Repeat("x", 64) + `"`))
	}))
	defer srv.Close()

	_, err := NewHTTPClient(srv.URL, WithMaxResponseBytes(32)).Call(context.Background(), http.MethodGet, "/", nil)
	if !errors.Is(err, ErrResponseTooLarge) {
		t.Fatalf("Call err = %v, want ErrResponseTooLarge", err)
	}
}

func TestCallAcceptsResponseExactlyAtTheLimit(t *testing.T) {
	body := `"` + strings.Repeat("x", 30) + `"` // 32 bytes
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		_, _ = w.Write([]byte(body))
	}))
	defer srv.Close()

	if _, err := NewHTTPClient(srv.URL, WithMaxResponseBytes(int64(len(body)))).Call(context.Background(), http.MethodGet, "/", nil); err != nil {
		t.Fatalf("Call at the limit: %v", err)
	}
}

func TestCallReturnsTypedStatusError(t *testing.T) {
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		w.WriteHeader(http.StatusNotFound)
	}))
	defer srv.Close()

	_, err := NewHTTPClient(srv.URL).Call(context.Background(), http.MethodGet, "/users/9", nil)
	var statusErr *StatusError
	if !errors.As(err, &statusErr) {
		t.Fatalf("Call err = %v, want *StatusError", err)
	}
	if statusErr.StatusCode != http.StatusNotFound || statusErr.Path != "/users/9" {
		t.Fatalf("StatusError = %+v, want 404 for /users/9", statusErr)
	}
}

func TestCallTreatsEmptyBodyAsNil(t *testing.T) {
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		w.WriteHeader(http.StatusNoContent)
	}))
	defer srv.Close()

	got, err := NewHTTPClient(srv.URL).Call(context.Background(), http.MethodDelete, "/users/1", nil)
	if err != nil || got != nil {
		t.Fatalf("Call = %#v, %v; want nil, nil", got, err)
	}
}
