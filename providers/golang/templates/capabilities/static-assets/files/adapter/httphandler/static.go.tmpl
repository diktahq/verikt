package {{index .ArchPaths "HTTPHandlerPkg"}}

import (
	"embed"
	"net/http"
)

// The assets live next to this file because go:embed cannot reach a parent
// directory. URLs map one-to-one onto the embedded tree: /static/css/style.css
// is static/css/style.css.
//
//go:embed static
var staticFS embed.FS

// StaticHandler returns an HTTP handler that serves embedded static files.
// Mount it at /static/; files are served with cache headers for production use.
func StaticHandler() http.Handler {
	return cacheControl(http.FileServer(http.FS(staticFS)))
}

func cacheControl(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Cache-Control", "public, max-age=31536000, immutable")
		next.ServeHTTP(w, r)
	})
}
